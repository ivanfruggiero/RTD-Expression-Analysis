#!/bin/bash
#PBS -N 06_assembly
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o logs/06_assembly.log

# Step 06 - Reference-guided transcript assembly of each pass-2 BAM with Scallop and/or StringTie.
# Output: OUTDIR/{scallop,stringtie}/<ID>.<assembler>.gtf  (assembler in the file name, so that
# the two assemblies of the same sample do not overwrite each other when collected by step 07).

set -euo pipefail
source "${PBS_O_WORKDIR:-$PWD}/script/common.sh"

usage() {
  cat <<'USAGE'
Usage: qsub -v BAMDIR=...,OUTDIR=...,ASSEMBLERS=both,REF_GTF=... script/06_assembly.pbs
   or: bash script/06_assembly.pbs [-b BAMDIR] [-o OUTDIR] [-a scallop|stringtie|both] [-g REF_GTF] [-t THREADS] [-f]
  -b BAMDIR      STAR pass-2 BAMs from step 05   (default: results/05_star/pass2)
  -o OUTDIR      output directory                (default: results/06_assembly)
  -a ASSEMBLERS  scallop, stringtie or both      (default: both)
  -g REF_GTF     reference GTF for StringTie -G  (default: reference/annotation.gtf)
  -t THREADS     threads for StringTie/samtools  (default: NCPUS or 12)
  -f             re-run even if output exists
USAGE
}

BAMDIR=${BAMDIR:-results/05_star/pass2}
OUTDIR=${OUTDIR:-results/06_assembly}
ASSEMBLERS=${ASSEMBLERS:-both}
REF_GTF=${REF_GTF:-reference/annotation.gtf}
THREADS=${THREADS:-$(ncpus 12)}
FORCE=${FORCE:-0}

while getopts ":b:o:a:g:t:fh" opt; do
  case $opt in
    b) BAMDIR=$OPTARG ;; o) OUTDIR=$OPTARG ;; a) ASSEMBLERS=$OPTARG ;;
    g) REF_GTF=$OPTARG ;; t) THREADS=$OPTARG ;; f) FORCE=1 ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

case "$ASSEMBLERS" in
  scallop)   RUN_SC=1; RUN_ST=0 ;;
  stringtie) RUN_SC=0; RUN_ST=1 ;;
  both)      RUN_SC=1; RUN_ST=1 ;;
  *) die "ASSEMBLERS must be scallop, stringtie or both" ;;
esac

setup_env
require_dir "$BAMDIR"
[ "$RUN_SC" -eq 0 ] || require_cmd scallop
[ "$RUN_ST" -eq 0 ] || { require_cmd stringtie samtools; require_file "$REF_GTF"; }
mkdir -p "$OUTDIR/scallop" "$OUTDIR/stringtie"

n=0
while read -r BAM; do
  ID=$(basename "$BAM" _Aligned.sortedByCoord.out.bam)
  if [ "$RUN_SC" -eq 1 ]; then
    out="$OUTDIR/scallop/${ID}.scallop.gtf"
    if [ "$FORCE" -eq 0 ] && [ -s "$out" ]; then log "[SKIP] $out"; else
      log "[RUN] Scallop $ID"; scallop -i "$BAM" -o "$out" < /dev/null; fi
  fi
  if [ "$RUN_ST" -eq 1 ]; then
    out="$OUTDIR/stringtie/${ID}.stringtie.gtf"
    if [ "$FORCE" -eq 0 ] && [ -s "$out" ]; then log "[SKIP] $out"; else
      [ -f "${BAM}.bai" ] || samtools index -@ "$THREADS" "$BAM"
      log "[RUN] StringTie $ID"; stringtie "$BAM" -p "$THREADS" -G "$REF_GTF" -l "$ID" -o "$out" < /dev/null; fi
  fi
  n=$((n + 1))
done < <(find "$BAMDIR" -maxdepth 1 -type f -name '*_Aligned.sortedByCoord.out.bam' | sort)

[ "$n" -gt 0 ] || die "no *_Aligned.sortedByCoord.out.bam in $BAMDIR"
log "Assembled $n sample(s) into $OUTDIR"

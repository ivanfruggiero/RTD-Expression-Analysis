#!/bin/bash
#PBS -N fastqc_multiqc
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=4:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/fastqc_multiqc.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

# Definizione variabili neutre per riproducibilità
WORKDIR=$PBS_O_WORKDIR
RAWDIR=../raw_reads
RESULTDIR=../results/fastqc
LOGDIR=../logs

cd $WORKDIR
mkdir -p $RESULTDIR
mkdir -p $LOGDIR

source /etc/profile.d/modules.sh

# Load modules
module purge
module load fastqc/0.11.9
module load multiqc/1.11

echo "Running FastQC on all .fastq.gz files in $RAWDIR..."
for file in $RAWDIR/*.fastq.gz; do
    if [ -f "$file" ]; then
        echo "Processing $file..."
        fastqc -o $RESULTDIR "$file"
    fi
done

echo "Running MultiQC on FastQC results..."
multiqc -o $RESULTDIR $RESULTDIR

echo "FastQC and MultiQC analysis completed on $(date)"
#!/bin/bash
#PBS -N 08_busco_rtd
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o logs/08_busco_rtd.log

# Step 08 - BUSCO completeness of the RTD transcript sequences.

set -euo pipefail
source "${PBS_O_WORKDIR:-$PWD}/script/common.sh"

usage() {
  cat <<'USAGE'
Usage: qsub -v LINEAGE=...[,INPUT=...] script/08_busco_transcriptome.pbs
   or: bash script/08_busco_transcriptome.pbs -l LINEAGE [-i INPUT] [-m MODE] [-o OUTDIR] [-n RUN_NAME] [-c THREADS]
  -l LINEAGE   BUSCO lineage dataset, directory or name (e.g. embryophyta_odb10)   (required)
  -i INPUT     input FASTA     (default: results/07_rtdmaker/RTD_RTDmaker_output/RTD.fixed.fa)
  -m MODE      BUSCO mode      (default: transcriptome)
  -o OUTDIR    output dir      (default: results/08_busco_rtd)
  -n RUN_NAME  run name        (default: busco_transcriptome)
  -c THREADS   threads         (default: NCPUS or 12)
An existing run with the same name is overwritten.
USAGE
}

INPUT=${INPUT:-results/07_rtdmaker/RTD_RTDmaker_output/RTD.fixed.fa}
LINEAGE=${LINEAGE:-}
MODE=${MODE:-transcriptome}
OUTDIR=${OUTDIR:-results/08_busco_rtd}
RUN_NAME=${RUN_NAME:-busco_transcriptome}
THREADS=${THREADS:-$(ncpus 12)}

while getopts ":i:l:m:o:n:c:h" opt; do
  case $opt in
    i) INPUT=$OPTARG ;; l) LINEAGE=$OPTARG ;; m) MODE=$OPTARG ;;
    o) OUTDIR=$OPTARG ;; n) RUN_NAME=$OPTARG ;; c) THREADS=$OPTARG ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

setup_env
require_cmd busco
require_file "$INPUT"
[ -n "$LINEAGE" ] || die "set LINEAGE (BUSCO lineage dataset), e.g. -l embryophyta_odb10"
mkdir -p "$OUTDIR"

# BUSCO stops on duplicated sequence IDs: keep the first sequence of each ID.
DEDUP="$OUTDIR/$(basename "$INPUT" | sed 's/\.[^.]*$//').dedupIDs.fa"
awk '/^>/ { id = substr($1, 2); keep = !(id in seen); seen[id] = 1 } keep' "$INPUT" > "$DEDUP"
log "input: $(grep -c '^>' "$INPUT") sequences, $(grep -c '^>' "$DEDUP") with unique IDs ($DEDUP)"
INPUT="$DEDUP"

log "$(busco --version) | INPUT=$INPUT LINEAGE=$LINEAGE MODE=$MODE OUT=$OUTDIR/$RUN_NAME"
busco -i "$INPUT" -l "$LINEAGE" -m "$MODE" -o "$RUN_NAME" --out_path "$OUTDIR" -c "$THREADS" -f
log "Done: $OUTDIR/$RUN_NAME (short_summary*.txt)"

#!/bin/bash
#PBS -N salmon_quantification
#PBS -l select=1:ncpus=16:mem=128gb
#PBS -l walltime=48:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/salmon_quantification.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qsub script/10_salmon_quantification.pbs [options]
  -t TRANSCRIPTOME_FA  transcriptome FASTA for indexing (default: ../results/rtdmaker/Citrus_RTD.fa)
  -s SAMPLES_TSV       TSV file with sample info: sample_id\tr1\tr2 (default: salmon_samples.tsv)
  -i INDEX_DIR         output directory for Salmon index (default: ../results/salmon/index)
  -o QUANTDIR          output directory for quantifications (default: ../results/salmon/quants)
  -m MAP_FILE          output TSV mapping sample to quant dir (default: ../results/salmon/sample_to_quantdir.tsv)
  -p THREADS           threads for Salmon (default: 12)
  -f                   force rerun even if output exists
  -h                   show this help message

Example:
  qsub script/10_salmon_quantification.pbs -t ../results/rtdmaker/Citrus_RTD.fa -s salmon_samples.tsv -i ../results/salmon/index -o ../results/salmon/quants -p 12
EOF
}

TRANSCRIPTOME_FA=${TRANSCRIPTOME_FA:-../results/rtdmaker/Citrus_RTD.fa}
SAMPLES_TSV=${SAMPLES_TSV:-salmon_samples.tsv}
INDEX_DIR=${INDEX_DIR:-../results/salmon/index}
QUANTDIR=${QUANTDIR:-../results/salmon/quants}
MAP_FILE=${MAP_FILE:-../results/salmon/sample_to_quantdir.tsv}
THREADS=${THREADS:-12}
FORCE=0

while getopts ":t:s:i:o:m:p:fh" opt; do
  case $opt in
    t) TRANSCRIPTOME_FA=$OPTARG ;;
    s) SAMPLES_TSV=$OPTARG ;;
    i) INDEX_DIR=$OPTARG ;;
    o) QUANTDIR=$OPTARG ;;
    m) MAP_FILE=$OPTARG ;;
    p) THREADS=$OPTARG ;;
    f) FORCE=1 ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

WORKDIR=${PBS_O_WORKDIR:-$(pwd)}
cd "$WORKDIR"

command -v salmon >/dev/null 2>&1 || { echo "[ERROR] salmon not found in PATH" >&2; exit 1; }

if [ ! -f "$TRANSCRIPTOME_FA" ]; then
  echo "[ERROR] transcriptome FASTA not found: $TRANSCRIPTOME_FA" >&2
  exit 1
fi

if [ ! -f "$SAMPLES_TSV" ]; then
  echo "[ERROR] samples TSV not found: $SAMPLES_TSV" >&2
  exit 1
fi

mkdir -p "$INDEX_DIR" "$QUANTDIR" "$(dirname "$MAP_FILE")"

cat <<EOF
===============================
[START] Salmon quantification
WORKDIR: $WORKDIR
TRANSCRIPTOME_FA: $TRANSCRIPTOME_FA
SAMPLES_TSV: $SAMPLES_TSV
INDEX_DIR: $INDEX_DIR
QUANTDIR: $QUANTDIR
MAP_FILE: $MAP_FILE
THREADS: $THREADS
FORCE: $FORCE
===============================
EOF

echo "[INFO] Salmon version:"
salmon --version

echo "[INFO] Build index"
if [[ ! -d "$INDEX_DIR" || $FORCE -eq 1 ]]; then
  salmon index -t "$TRANSCRIPTOME_FA" -i "$INDEX_DIR" -p "$THREADS"
else
  echo "[SKIP] Index exists: $INDEX_DIR"
fi

echo "[INFO] Quantify samples"
echo -e "sample_id\tquant_dir" > "$MAP_FILE"

tail -n +2 "$SAMPLES_TSV" | while IFS=$'\t' read -r sample r1 r2; do
  [ -z "$sample" ] && continue
  out="${QUANTDIR}/${sample}"
  mkdir -p "$out"

  if [[ -s "${out}/quant.sf" && $FORCE -eq 0 ]]; then
    echo "[SKIP] Quantification exists for $sample"
  else
    echo "[RUN] Quantify $sample"
    salmon quant \
      -i "$INDEX_DIR" \
      -l A \
      -1 "$r1" -2 "$r2" \
      -p "$THREADS" \
      --validateMappings \
      --gcBias \
      --seqBias \
      -o "$out"
  fi

  echo -e "${sample}\t${out}" >> "$MAP_FILE"
done

echo "==============================="
echo "[DONE] Salmon quantification completed"
echo "Index: $INDEX_DIR"
echo "Quants: $QUANTDIR"
echo "Map: $MAP_FILE"
echo "==============================="

#!/bin/bash
#PBS -N rtdmaker
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=72:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/rtdmaker.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qsub script/06_rtdmaker.pbs [options]
  -a ASSEMBLY_DIR   directory with assembly GTF files (default: ../results/assembly)
  -l ASSEMBLY_LIST  optional file listing assemblies, one per line
  -s SJ_DIR         directory with STAR SJ.out.tab files (default: ../results/star_alignment/pass1)
  -f FASTQ_DIR      directory with FASTQ files for RTDmaker (default: ../results/trimming_qc/trimmed)
  -r REFDIR         reference directory (default: ../reference)
  -g GENOME_FA      genome FASTA file (default: ../reference/genome.fa)
  -t REF_GTF        reference annotation GTF for StringTie/RTDmaker (default: ../reference/annotations.gtf)
  -o OUTDIR         RTDmaker output directory (default: ../results/rtdmaker)
  -n OUTNAME        RTDmaker outname (default: Citrus_RTD)
  -p PREFIX         RTDmaker prefix (default: CitrusRTD)
  -m RAM            RAM argument in GB (default: 8)
  -k KEEP          keep option (default: intermediary)
  -h                show this help message

Example:
  qsub script/06_rtdmaker.pbs -a ../results/assembly -s ../results/star_alignment/pass1 -f ../results/trimming_qc/trimmed -r ../reference -g ../reference/genome.fa -t ../reference/annotations.gtf -o ../results/rtdmaker -n MyRTD -p MyPrefix -m 8
EOF
}

ASSEMBLY_DIR=${ASSEMBLY_DIR:-../results/assembly}
ASSEMBLY_LIST=${ASSEMBLY_LIST:-}
SJ_DIR=${SJ_DIR:-../results/star_alignment/pass1}
FASTQ_DIR=${FASTQ_DIR:-../results/trimming_qc/trimmed}
REFDIR=${REFDIR:-../reference}
GENOME_FA=${GENOME_FA:-$REFDIR/genome.fa}
REF_GTF=${REF_GTF:-$REFDIR/annotations.gtf}
OUTDIR=${OUTDIR:-../results/rtdmaker}
OUTNAME=${OUTNAME:-Citrus_RTD}
PREFIX=${PREFIX:-CitrusRTD}
RAM=${RAM:-8}
KEEP=${KEEP:-intermediary}

while getopts ":a:l:s:f:r:g:o:n:p:m:k:h" opt; do
  case $opt in
    a) ASSEMBLY_DIR=$OPTARG ;;
    l) ASSEMBLY_LIST=$OPTARG ;;
    s) SJ_DIR=$OPTARG ;;
    f) FASTQ_DIR=$OPTARG ;;
    r) REFDIR=$OPTARG ;;
    g) GENOME_FA=$OPTARG ;;
    o) OUTDIR=$OPTARG ;;
    n) OUTNAME=$OPTARG ;;
    p) PREFIX=$OPTARG ;;
    m) RAM=$OPTARG ;;
    k) KEEP=$OPTARG ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

WORKDIR=${PBS_O_WORKDIR:-$(pwd)}
cd "$WORKDIR"

if command -v module >/dev/null 2>&1; then
  module purge
  module load rtdmaker/1.0.0
fi

RTDMAKER_CMD=""
if command -v RTDmaker.py >/dev/null 2>&1; then
  RTDMAKER_CMD=$(command -v RTDmaker.py)
elif [ -n "${RTDMAKER_PREFIX:-}" ] && [ -f "${RTDMAKER_PREFIX}/RTDmaker.py" ]; then
  RTDMAKER_CMD="${RTDMAKER_PREFIX}/RTDmaker.py"
fi

if [ -z "$RTDMAKER_CMD" ]; then
  echo "[ERROR] RTDmaker.py not found. Set RTDMAKER_PREFIX or ensure RTDmaker.py is in PATH." >&2
  exit 1
fi

if [ ! -f "$GENOME_FA" ]; then
  echo "[ERROR] genome FASTA not found: $GENOME_FA" >&2
  exit 1
fi

if [ ! -f "$REF_GTF" ]; then
  echo "[ERROR] reference GTF not found: $REF_GTF" >&2
  exit 1
fi

if [ ! -d "$SJ_DIR" ]; then
  echo "[ERROR] SJ directory not found: $SJ_DIR" >&2
  exit 1
fi

if [ ! -d "$FASTQ_DIR" ]; then
  echo "[ERROR] FASTQ directory not found: $FASTQ_DIR" >&2
  exit 1
fi

if [ -n "$ASSEMBLY_LIST" ]; then
  if [ ! -f "$ASSEMBLY_LIST" ]; then
    echo "[ERROR] Assembly list not found: $ASSEMBLY_LIST" >&2
    exit 1
  fi
else
  if [ ! -d "$ASSEMBLY_DIR" ]; then
    echo "[ERROR] Assembly directory not found: $ASSEMBLY_DIR" >&2
    exit 1
  fi
fi

mkdir -p "$OUTDIR"
mkdir -p "$OUTDIR/input/assemblies"
mkdir -p "$OUTDIR/reference_gtf"
mkdir -p "$OUTDIR/logs"

LINKED_ASSEMBLIES="$OUTDIR/input/assemblies/list.txt"
rm -f "$LINKED_ASSEMBLIES"

echo "[INFO] Preparing assemblies"
if [ -n "$ASSEMBLY_LIST" ]; then
  cp "$ASSEMBLY_LIST" "$LINKED_ASSEMBLIES"
else
  find "$ASSEMBLY_DIR" -type f \( -name '*.gtf' -o -name '*.GTF' \) | sort > "$LINKED_ASSEMBLIES"
fi

if [ ! -s "$LINKED_ASSEMBLIES" ]; then
  echo "[ERROR] No assembly files found in $ASSEMBLY_DIR" >&2
  exit 1
fi

ASSEMBLY_TARGET_DIR="$OUTDIR/input/assemblies"
while IFS= read -r asm; do
  if [ -z "$asm" ]; then
    continue
  fi
  if [ ! -f "$asm" ]; then
    echo "[WARN] Assembly file not found: $asm" >&2
    continue
  fi
  ln -sf "$asm" "$ASSEMBLY_TARGET_DIR/$(basename "$asm")"
done < "$LINKED_ASSEMBLIES"

if [ -z "$(find "$ASSEMBLY_TARGET_DIR" -maxdepth 1 -type f -name '*.gtf' | head -n 1)" ]; then
  echo "[ERROR] No assembly GTF linked" >&2
  exit 1
fi

ln -sf "$REF_GTF" "$OUTDIR/reference_gtf/$(basename "$REF_GTF")"

cat <<EOF
===============================
[START] RTDmaker
WORKDIR: $WORKDIR
RTDmaker: $RTDMAKER_CMD
ASSEMBLY_DIR: $ASSEMBLY_DIR
ASSEMBLY_LIST: ${ASSEMBLY_LIST:-<auto>}
SJ_DIR: $SJ_DIR
FASTQ_DIR: $FASTQ_DIR
GENOME_FA: $GENOME_FA
REF_GTF: $REF_GTF
OUTDIR: $OUTDIR
OUTNAME: $OUTNAME
PREFIX: $PREFIX
RAM: $RAM
KEEP: $KEEP
===============================
EOF

python "$RTDMAKER_CMD" ShortReads \
  --assemblies "$ASSEMBLY_TARGET_DIR" \
  --references "$OUTDIR/reference_gtf" \
  --SJ-data "$SJ_DIR" \
  --fastq "$FASTQ_DIR" \
  --SJ-reads 5 1 \
  --genome "$GENOME_FA" \
  --tpm 0.5 1 \
  --fragment-len 0.70 \
  --antisense-len 0.50 \
  --ram "$RAM" \
  --keep "$KEEP" \
  --outpath "$OUTDIR" \
  --outname "$OUTNAME" \
  --prefix "$PREFIX" \
  --overwrite

echo "==============================="
echo "[SUCCESS] RTDmaker completed"
echo "OUTDIR: $OUTDIR"
echo "==============================="

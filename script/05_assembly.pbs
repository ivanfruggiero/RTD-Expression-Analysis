#!/bin/bash
#PBS -N assembly_tools
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=48:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/assembly.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qsub script/05_assembly.pbs [options]
  -b BAMDIR      base directory for STAR pass2 BAM files (default: ../results/star_alignment/pass2)
  -o OUTDIR      base directory for assembly output (default: ../results/assembly)
  -a ASSEMBLERS  comma-separated assemblers to run: scallop,stringtie,both (default: both)
  -g GTF         reference GTF for StringTie (default: ../reference/annotations.gtf)
  -t THREADS     threads for StringTie / samtools (default: 8)
  -f             force rerun even if output exists
  -h             show this help message

Examples:
  qsub script/05_assembly.pbs -b ../results/star_alignment/pass2 -o ../results/assembly -a both -g ../reference/annotations.gtf -t 12
  qsub script/05_assembly.pbs -a scallop
EOF
}

BAMDIR=${BAMDIR:-../results/star_alignment/pass2}
OUTDIR=${OUTDIR:-../results/assembly}
ASSEMBLERS=${ASSEMBLERS:-both}
GTF=${GTF:-../reference/annotations.gtf}
THREADS=${THREADS:-8}
FORCE=0

while getopts ":b:o:a:g:t:fh" opt; do
  case $opt in
    b) BAMDIR=$OPTARG ;;
    o) OUTDIR=$OPTARG ;;
    a) ASSEMBLERS=$OPTARG ;;
    g) GTF=$OPTARG ;;
    t) THREADS=$OPTARG ;;
    f) FORCE=1 ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

WORKDIR=${PBS_O_WORKDIR:-$(pwd)}
cd "$WORKDIR"

if [ ! -d "$BAMDIR" ]; then
  echo "[ERROR] BAM directory not found: $BAMDIR" >&2
  exit 1
fi

case "$ASSEMBLERS" in
  scallop|stringtie|both) ;;
  *)
    echo "[ERROR] Assemblers must be 'scallop', 'stringtie' or 'both'" >&2
    usage
    exit 1
    ;;
esac

if [[ "$ASSEMBLERS" == "stringtie" || "$ASSEMBLERS" == "both" ]]; then
  if [ ! -f "$GTF" ]; then
    echo "[ERROR] StringTie reference GTF not found: $GTF" >&2
    exit 1
  fi
fi

command -v scallop >/dev/null 2>&1 || { echo "[WARN] scallop not available in PATH" >&2; }
command -v stringtie >/dev/null 2>&1 || { echo "[WARN] stringtie not available in PATH" >&2; }
command -v samtools >/dev/null 2>&1 || { echo "[WARN] samtools not available in PATH" >&2; }

ASSEMBLY_LOG="${OUTDIR}/logs"
SCALLOP_DIR="${OUTDIR}/scallop"
STRINGTIE_DIR="${OUTDIR}/stringtie"

mkdir -p "$ASSEMBLY_LOG" "$SCALLOP_DIR" "$STRINGTIE_DIR"

echo "=========================================="
echo "[START] assembly pipeline"
echo "WORKDIR: $WORKDIR"
echo "BAMDIR: $BAMDIR"
echo "OUTDIR: $OUTDIR"
echo "ASSEMBLERS: $ASSEMBLERS"
echo "GTF: $GTF"
echo "THREADS: $THREADS"
echo "FORCE: $FORCE"
echo "=========================================="

find "$BAMDIR" -maxdepth 1 -type f -name "*.bam" -print0 | sort -z | while IFS= read -r -d '' BAM; do
  SAMPLE=$(basename "$BAM" .bam)

  echo "\n[START] sample: $SAMPLE"
  echo "BAM: $BAM"

  if [[ "$ASSEMBLERS" == "scallop" || "$ASSEMBLERS" == "both" ]]; then
    OUT_GTF="$SCALLOP_DIR/${SAMPLE}.gtf"
    if [[ $FORCE -eq 0 && -f "$OUT_GTF" ]]; then
      echo "[SKIP] Scallop output already exists: $OUT_GTF"
    else
      echo "[RUN] Scallop for $SAMPLE"
      if ! command -v scallop >/dev/null 2>&1; then
        echo "[ERROR] scallop not found in PATH" >&2
        exit 1
      fi
      scallop -i "$BAM" -o "$OUT_GTF"
      echo "[DONE] Scallop output: $OUT_GTF"
    fi
  fi

  if [[ "$ASSEMBLERS" == "stringtie" || "$ASSEMBLERS" == "both" ]]; then
    OUT_GTF="$STRINGTIE_DIR/${SAMPLE}.gtf"
    if [[ $FORCE -eq 0 && -f "$OUT_GTF" ]]; then
      echo "[SKIP] StringTie output already exists: $OUT_GTF"
    else
      echo "[RUN] StringTie for $SAMPLE"
      if ! command -v stringtie >/dev/null 2>&1; then
        echo "[ERROR] stringtie not found in PATH" >&2
        exit 1
      fi
      if ! command -v samtools >/dev/null 2>&1; then
        echo "[WARN] samtools not found in PATH; continuing anyway" >&2
      else
        if [[ ! -f "${BAM}.bai" ]]; then
          echo "[INFO] Generating BAM index for $BAM"
          samtools index "$BAM"
        fi
      fi
      stringtie "$BAM" -p "$THREADS" -G "$GTF" -o "$OUT_GTF" -l "$SAMPLE"
      echo "[DONE] StringTie output: $OUT_GTF"
    fi
  fi

done

echo "[FINISHED] assembly pipeline completed"

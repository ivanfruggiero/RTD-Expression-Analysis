#!/bin/bash
#PBS -N 11_salmon
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o logs/11_salmon.log

# Step 11 - Salmon index on the RTD and per-sample quantification of the decontaminated reads (step 03).
# Samples are taken from READS_DIR automatically (sample ID = read file name without
# _1/_2.trimmed.fastq.gz), or from SAMPLES_TSV (header: sample_id r1 r2; empty r2 = single-end).
# These sample IDs are the ones to use in the DESeq2 metadata (step 13).
# Output: OUTDIR/quants/<sample_id>/quant.sf

set -euo pipefail
source "${PBS_O_WORKDIR:-$PWD}/script/common.sh"

usage() {
  cat <<'USAGE'
Usage: qsub [-v RTD_FA=...,OUTDIR=...] script/11_salmon_quantification.pbs
   or: bash script/11_salmon_quantification.pbs [-t RTD_FA] [-q READS_DIR] [-s SAMPLES_TSV] [-o OUTDIR] [-p THREADS] [-f]
  -t RTD_FA       transcripts to index   (default: results/07_rtdmaker/RTD_RTDmaker_output/RTD.salmon_unique.fa)
  -q READS_DIR    reads, step 03 (or 02) (default: results/03_screening/clean)
  -s SAMPLES_TSV  optional sample sheet (overrides READS_DIR)
  -o OUTDIR       output directory       (default: results/11_salmon)
  -p THREADS      threads                (default: NCPUS or 16)
  -f              rebuild the index and re-quantify existing samples
USAGE
}

RTD_FA=${RTD_FA:-results/07_rtdmaker/RTD_RTDmaker_output/RTD.salmon_unique.fa}
READS_DIR=${READS_DIR:-results/03_screening/clean}
SAMPLES_TSV=${SAMPLES_TSV:-}
OUTDIR=${OUTDIR:-results/11_salmon}
THREADS=${THREADS:-$(ncpus 16)}
FORCE=${FORCE:-0}

while getopts ":t:q:s:o:p:fh" opt; do
  case $opt in
    t) RTD_FA=$OPTARG ;; q) READS_DIR=$OPTARG ;; s) SAMPLES_TSV=$OPTARG ;;
    o) OUTDIR=$OPTARG ;; p) THREADS=$OPTARG ;; f) FORCE=1 ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

setup_env
require_cmd salmon
require_file "$RTD_FA"

INDEX="$OUTDIR/index"; QUANTS="$OUTDIR/quants"; SHEET="$OUTDIR/samples.tsv"
mkdir -p "$OUTDIR" "$QUANTS"

if [ -n "$SAMPLES_TSV" ]; then
  require_file "$SAMPLES_TSV"
  cp "$SAMPLES_TSV" "$SHEET"
else
  require_dir "$READS_DIR"
  { printf 'sample_id\tr1\tr2\n'; list_trimmed_samples "$READS_DIR" | cut -f2-4; } > "$SHEET"
fi
[ "$(tail -n +2 "$SHEET" | grep -c .)" -gt 0 ] || die "no samples found"
dups=$(tail -n +2 "$SHEET" | cut -f1 | sort | uniq -d)
[ -z "$dups" ] || die "duplicated sample IDs: $dups"

log "$(salmon --version) | RTD=$RTD_FA OUT=$OUTDIR THREADS=$THREADS"
if [ "$FORCE" -eq 1 ] || [ ! -s "$INDEX/versionInfo.json" ]; then
  log "Building index"
  salmon index -t "$RTD_FA" -i "$INDEX" -p "$THREADS"
else
  log "[SKIP] index exists: $INDEX"
fi

while IFS=$'\t' read -r S R1 R2; do
  [ -n "$S" ] || continue
  out="$QUANTS/$S"
  if [ "$FORCE" -eq 0 ] && [ -s "$out/quant.sf" ]; then log "[SKIP] $S"; continue; fi
  if [ -n "${R2:-}" ]; then READS=(-1 "$R1" -2 "$R2"); else READS=(-r "$R1"); fi
  log "[RUN] $S"
  salmon quant -i "$INDEX" -l A "${READS[@]}" -p "$THREADS" \
    --validateMappings --gcBias --seqBias -o "$out" < /dev/null
done < <(tail -n +2 "$SHEET")

log "Done: $QUANTS (sample sheet: $SHEET; mapping rates in */logs/salmon_quant.log)"

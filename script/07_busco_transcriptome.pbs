#!/bin/bash
#PBS -N busco_transcriptome
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=48:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/busco_transcriptome.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qsub script/07_busco_transcriptome.pbs [options]
  -i INPUT_FA     input transcriptome FASTA (default: ../results/rtdmaker/${OUTNAME}.fa)
  -d DBDIR        BUSCO lineage database directory (default: ../reference/eudicots_odb10)
  -m MODE         BUSCO mode (default: transcriptome)
  -o OUTDIR       output directory (default: ../results/busco)
  -n OUTNAME      BUSCO run name (default: busco_transcriptome)
  -c THREADS      BUSCO threads (default: 12)
  -h              show this help message

Example:
  qsub script/07_busco_transcriptome.pbs -i ../results/rtdmaker/Citrus_RTD.fa -d ../reference/eudicots_odb10 -o ../results/busco -n Citrus_RTD_busco -c 12
EOF
}

OUTNAME=${OUTNAME:-busco_transcriptome}
INPUT_FA=${INPUT_FA:-}
DBDIR=${DBDIR:-../reference/eudicots_odb10}
MODE=${MODE:-transcriptome}
OUTDIR=${OUTDIR:-../results/busco}
THREADS=${THREADS:-12}

while getopts ":i:d:m:o:n:c:h" opt; do
  case $opt in
    i) INPUT_FA=$OPTARG ;;
    d) DBDIR=$OPTARG ;;
    m) MODE=$OPTARG ;;
    o) OUTDIR=$OPTARG ;;
    n) OUTNAME=$OPTARG ;;
    c) THREADS=$OPTARG ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

if [ -z "$INPUT_FA" ]; then
  INPUT_FA="../results/rtdmaker/${OUTNAME}.fa"
fi

WORKDIR=${PBS_O_WORKDIR:-$(pwd)}
cd "$WORKDIR"

command -v busco >/dev/null 2>&1 || { echo "[ERROR] busco not found in PATH" >&2; exit 1; }

if [ ! -f "$INPUT_FA" ]; then
  echo "[ERROR] input FASTA not found: $INPUT_FA" >&2
  exit 1
fi

if [ ! -d "$DBDIR" ]; then
  echo "[ERROR] BUSCO database directory not found: $DBDIR" >&2
  exit 1
fi

mkdir -p "$OUTDIR"

cat <<EOF
===============================
[START] BUSCO transcriptome assessment
WORKDIR: $WORKDIR
INPUT_FA: $INPUT_FA
DBDIR: $DBDIR
MODE: $MODE
OUTDIR: $OUTDIR
OUTNAME: $OUTNAME
THREADS: $THREADS
===============================
EOF

busco \
  -i "$INPUT_FA" \
  -l "$DBDIR" \
  -m "$MODE" \
  -o "$OUTNAME" \
  -c "$THREADS" \
  --out_path "$OUTDIR"

echo "==============================="
echo "[DONE] BUSCO completed"
echo "Results: $OUTDIR/$OUTNAME"
echo "==============================="

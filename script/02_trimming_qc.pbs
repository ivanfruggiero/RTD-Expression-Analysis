#!/bin/bash
#PBS -N 02_trimming_qc
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o logs/02_trimming_qc.log

# Step 02 - Read trimming with fastp, then FastQC/MultiQC on trimmed reads.
# Per-BioProject trimming parameters are read from CONFIG (see config/trimming_config.txt).
# Input : RAW_BASE/paired/<BP>/<SAMPLE>_1.fastq.gz + <SAMPLE>_2.fastq.gz
#         RAW_BASE/single/<BP>/<SAMPLE>.fastq.gz
# Output: OUTDIR/trimmed/{paired,single}/<BP>/<SAMPLE>[_1|_2].trimmed.fastq.gz

set -euo pipefail
source "${PBS_O_WORKDIR:-$PWD}/script/common.sh"

usage() {
  cat <<'USAGE'
Usage: qsub -v RAW_BASE=...,OUTDIR=...,CONFIG=...,THREADS=... script/02_trimming_qc.pbs
   or: bash script/02_trimming_qc.pbs [-i RAW_BASE] [-o OUTDIR] [-c CONFIG] [-t THREADS]
  -i RAW_BASE  base directory of raw reads          (default: raw_reads)
  -o OUTDIR    output base directory                (default: results/02_trimming)
  -c CONFIG    trimming configuration file          (default: config/trimming_config.txt)
  -t THREADS   threads for fastp / FastQC           (default: NCPUS or 12)
CONFIG columns (whitespace separated, '#' = comment):
  BIOPROJECT  TRIM_FRONT1  TRIM_FRONT2  MIN_PHRED  N_BASE_LIMIT
USAGE
}

RAW_BASE=${RAW_BASE:-raw_reads}
OUTDIR=${OUTDIR:-results/02_trimming}
CONFIG=${CONFIG:-config/trimming_config.txt}
THREADS=${THREADS:-$(ncpus 12)}

while getopts ":i:o:c:t:h" opt; do
  case $opt in
    i) RAW_BASE=$OPTARG ;; o) OUTDIR=$OPTARG ;; c) CONFIG=$OPTARG ;; t) THREADS=$OPTARG ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

setup_env
require_cmd fastp fastqc multiqc
require_file "$CONFIG"
require_dir "$RAW_BASE"

TRIMDIR="$OUTDIR/trimmed"
FASTP_DIR="$OUTDIR/fastp_reports"
FASTQC_DIR="$OUTDIR/fastqc_trimmed"
LOGDIR="$OUTDIR/logs"
mkdir -p "$TRIMDIR" "$FASTP_DIR" "$FASTQC_DIR" "$LOGDIR"

log "RAW_BASE=$RAW_BASE OUTDIR=$OUTDIR CONFIG=$CONFIG THREADS=$THREADS"
fastp --version 2>&1 | head -1

while read -r BIOPROJECT TRIM1 TRIM2 PHRED NLIMIT _; do
  [ -n "${NLIMIT:-}" ] || die "malformed line in $CONFIG for '$BIOPROJECT' (5 columns expected)"
  log "=== BioProject: $BIOPROJECT (trim_front1=$TRIM1 trim_front2=$TRIM2 phred=$PHRED n_limit=$NLIMIT)"
  found=0

  RAW_PAIRED="$RAW_BASE/paired/$BIOPROJECT"
  if [ -d "$RAW_PAIRED" ]; then
    while read -r fq1; do
      fq2="${fq1%_1.fastq.gz}_2.fastq.gz"
      [ -f "$fq2" ] || { warn "mate not found for $fq1, skipping"; continue; }
      S=$(basename "$fq1" _1.fastq.gz)
      out="$TRIMDIR/paired/$BIOPROJECT"; rep="$FASTP_DIR/paired/$BIOPROJECT"; qc="$FASTQC_DIR/paired/$BIOPROJECT"
      mkdir -p "$out" "$rep" "$qc"
      log "fastp (paired) $S"
      fastp -i "$fq1" -I "$fq2" \
        -o "$out/${S}_1.trimmed.fastq.gz" -O "$out/${S}_2.trimmed.fastq.gz" \
        --trim_front1 "$TRIM1" --trim_front2 "$TRIM2" \
        --qualified_quality_phred "$PHRED" --unqualified_percent_limit 50 \
        --n_base_limit "$NLIMIT" --detect_adapter_for_pe \
        --thread "$THREADS" --json "$rep/${S}.json" --html "$rep/${S}.html" \
        --report_title "fastp - ${S}" > "$LOGDIR/${S}_fastp.log" 2>&1 < /dev/null
      fastqc --threads "$THREADS" -o "$qc" "$out/${S}_1.trimmed.fastq.gz" "$out/${S}_2.trimmed.fastq.gz" \
        > "$LOGDIR/${S}_fastqc.log" 2>&1 < /dev/null
      found=1
    done < <(find "$RAW_PAIRED" -maxdepth 1 -type f -name '*_1.fastq.gz' | sort)
  fi

  RAW_SINGLE="$RAW_BASE/single/$BIOPROJECT"
  if [ -d "$RAW_SINGLE" ]; then
    while read -r fq; do
      S=$(basename "$fq" .fastq.gz)
      out="$TRIMDIR/single/$BIOPROJECT"; rep="$FASTP_DIR/single/$BIOPROJECT"; qc="$FASTQC_DIR/single/$BIOPROJECT"
      mkdir -p "$out" "$rep" "$qc"
      log "fastp (single) $S"
      fastp -i "$fq" -o "$out/${S}.trimmed.fastq.gz" \
        --trim_front1 "$TRIM1" \
        --qualified_quality_phred "$PHRED" --unqualified_percent_limit 50 \
        --n_base_limit "$NLIMIT" \
        --thread "$THREADS" --json "$rep/${S}.json" --html "$rep/${S}.html" \
        --report_title "fastp - ${S}" > "$LOGDIR/${S}_fastp.log" 2>&1 < /dev/null
      fastqc --threads "$THREADS" -o "$qc" "$out/${S}.trimmed.fastq.gz" > "$LOGDIR/${S}_fastqc.log" 2>&1 < /dev/null
      found=1
    done < <(find "$RAW_SINGLE" -maxdepth 1 -type f -name '*.fastq.gz' | grep -vE '_[12]\.fastq\.gz$' | sort)
  fi

  [ "$found" -eq 1 ] || warn "no reads found for $BIOPROJECT under $RAW_BASE/{paired,single}/"
done < <(grep -Ev '^[[:space:]]*(#|$)' "$CONFIG")

log "MultiQC on trimmed reads"
multiqc -f -o "$OUTDIR/multiqc" "$FASTQC_DIR" "$FASTP_DIR" > "$LOGDIR/multiqc.log" 2>&1
log "Done: $TRIMDIR"

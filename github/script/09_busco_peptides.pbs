#!/bin/bash
#PBS -N busco_peptides
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=24:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/busco_peptides.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qsub script/09_busco_peptides.pbs [options]
  -i INPUT_PEP    input peptide FASTA (default: ../results/transdecoder/Citrus_RTD.fa.transdecoder.pep)
  -d DBDIR        BUSCO lineage database directory (default: ../reference/eudicots_odb10)
  -m MODE         BUSCO mode (default: protein)
  -o OUTDIR       output directory (default: ../results/busco_peptides)
  -n OUTNAME      BUSCO run name (default: busco_peptides)
  -c THREADS      BUSCO threads (default: 12)
  -h              show this help message

Example:
  qsub script/09_busco_peptides.pbs -i ../results/transdecoder/Citrus_RTD.fa.transdecoder.pep -d ../reference/eudicots_odb10 -o ../results/busco_peptides -n Citrus_pep_busco -c 12
EOF
}

OUTNAME=${OUTNAME:-busco_peptides}
INPUT_PEP=${INPUT_PEP:-../results/transdecoder/Citrus_RTD.fa.transdecoder.pep}
DBDIR=${DBDIR:-../reference/eudicots_odb10}
MODE=${MODE:-protein}
OUTDIR=${OUTDIR:-../results/busco_peptides}
THREADS=${THREADS:-12}

while getopts ":i:d:m:o:n:c:h" opt; do
  case $opt in
    i) INPUT_PEP=$OPTARG ;;
    d) DBDIR=$OPTARG ;;
    m) MODE=$OPTARG ;;
    o) OUTDIR=$OPTARG ;;
    n) OUTNAME=$OPTARG ;;
    c) THREADS=$OPTARG ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

WORKDIR=${PBS_O_WORKDIR:-$(pwd)}
cd "$WORKDIR"

command -v busco >/dev/null 2>&1 || { echo "[ERROR] busco not found in PATH" >&2; exit 1; }

if [ ! -f "$INPUT_PEP" ]; then
  echo "[ERROR] input peptide FASTA not found: $INPUT_PEP" >&2
  exit 1
fi

if [ ! -d "$DBDIR" ]; then
  echo "[ERROR] BUSCO database directory not found: $DBDIR" >&2
  exit 1
fi

mkdir -p "$OUTDIR"

# Remove existing run to avoid errors
if [ -d "$OUTDIR/$OUTNAME" ]; then
  echo "[INFO] Removing existing run: $OUTDIR/$OUTNAME"
  rm -rf "$OUTDIR/$OUTNAME"
fi

cat <<EOF
===============================
[START] BUSCO peptide assessment
WORKDIR: $WORKDIR
INPUT_PEP: $INPUT_PEP
DBDIR: $DBDIR
MODE: $MODE
OUTDIR: $OUTDIR
OUTNAME: $OUTNAME
THREADS: $THREADS
===============================
EOF

busco \
  -i "$INPUT_PEP" \
  -l "$DBDIR" \
  -m "$MODE" \
  -o "$OUTNAME" \
  -c "$THREADS" \
  --out_path "$OUTDIR"

echo "==============================="
echo "[DONE] BUSCO peptides completed"
echo "Results: $OUTDIR/$OUTNAME"
echo "==============================="

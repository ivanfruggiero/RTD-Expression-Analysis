#!/bin/bash
#PBS -N interproscan
#PBS -l select=1:ncpus=16:mem=128gb
#PBS -l walltime=240:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/interproscan.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qsub script/11_interproscan.pbs [options]
  -i INPUT_PEP    input peptide FASTA (default: ../results/transdecoder/Citrus_RTD.fa.transdecoder.pep)
  -o OUTDIR       output directory (default: ../results/interproscan)
  -t TMPDIR       temporary directory (default: ../results/interproscan/tmp)
  -c THREADS      CPU threads (default: 12)
  -f FORMATS      output formats: TSV,XML,GFF3 (default: TSV,XML,GFF3)
  -h              show this help message

Example:
  qsub script/11_interproscan.pbs -i ../results/transdecoder/Citrus_RTD.fa.transdecoder.pep -o ../results/interproscan -c 12
EOF
}

INPUT_PEP=${INPUT_PEP:-../results/transdecoder/Citrus_RTD.fa.transdecoder.pep}
OUTDIR=${OUTDIR:-../results/interproscan}
TMPDIR=${TMPDIR:-../results/interproscan/tmp}
THREADS=${THREADS:-12}
FORMATS=${FORMATS:-TSV,XML,GFF3}

while getopts ":i:o:t:c:f:h" opt; do
  case $opt in
    i) INPUT_PEP=$OPTARG ;;
    o) OUTDIR=$OPTARG ;;
    t) TMPDIR=$OPTARG ;;
    c) THREADS=$OPTARG ;;
    f) FORMATS=$OPTARG ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

WORKDIR=${PBS_O_WORKDIR:-$(pwd)}
cd "$WORKDIR"

command -v interproscan.sh >/dev/null 2>&1 || { echo "[ERROR] interproscan.sh not found in PATH" >&2; exit 1; }

if [ ! -f "$INPUT_PEP" ]; then
  echo "[ERROR] input peptide FASTA not found: $INPUT_PEP" >&2
  exit 1
fi

mkdir -p "$OUTDIR" "$TMPDIR"

cat <<EOF
===============================
[START] InterProScan annotation
WORKDIR: $WORKDIR
INPUT_PEP: $INPUT_PEP
OUTDIR: $OUTDIR
TMPDIR: $TMPDIR
THREADS: $THREADS
FORMATS: $FORMATS
===============================
EOF

echo "[INFO] InterProScan version:"
interproscan.sh --version || true

echo "[INFO] Sequences: $(grep -c '^>' "$INPUT_PEP")"

interproscan.sh \
  -i "$INPUT_PEP" \
  -f "$FORMATS" \
  -dp \
  -goterms \
  -iprlookup \
  --cpu "$THREADS" \
  --tempdir "$TMPDIR" \
  -d "$OUTDIR"

echo "==============================="
echo "[DONE] InterProScan completed"
echo "OUTDIR: $OUTDIR"
echo "Outputs:"
ls -lh "$OUTDIR" | head -20
echo "==============================="

#!/bin/bash
#PBS -N transdecoder
#PBS -l select=1:ncpus=12:mem=64gb
#PBS -l walltime=24:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/transdecoder.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qsub script/08_transdecoder.pbs [options]
  -i INPUT_FA     input transcriptome FASTA (default: ../results/rtdmaker/Citrus_RTD.fa)
  -o OUTDIR       output directory (default: ../results/transdecoder)
  -h              show this help message

Example:
  qsub script/08_transdecoder.pbs -i ../results/rtdmaker/Citrus_RTD.fa -o ../results/transdecoder
EOF
}

INPUT_FA=${INPUT_FA:-../results/rtdmaker/Citrus_RTD.fa}
OUTDIR=${OUTDIR:-../results/transdecoder}

while getopts ":i:o:h" opt; do
  case $opt in
    i) INPUT_FA=$OPTARG ;;
    o) OUTDIR=$OPTARG ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

WORKDIR=${PBS_O_WORKDIR:-$(pwd)}
cd "$WORKDIR"

command -v TransDecoder.LongOrfs >/dev/null 2>&1 || { echo "[ERROR] TransDecoder.LongOrfs not found in PATH" >&2; exit 1; }
command -v TransDecoder.Predict >/dev/null 2>&1 || { echo "[ERROR] TransDecoder.Predict not found in PATH" >&2; exit 1; }

if [ ! -f "$INPUT_FA" ]; then
  echo "[ERROR] input FASTA not found: $INPUT_FA" >&2
  exit 1
fi

mkdir -p "$OUTDIR"

cat <<EOF
===============================
[START] TransDecoder ORF prediction
WORKDIR: $WORKDIR
INPUT_FA: $INPUT_FA
OUTDIR: $OUTDIR
===============================
EOF

cd "$OUTDIR"

echo "[RUN] TransDecoder.LongOrfs"
TransDecoder.LongOrfs -t "$INPUT_FA"

echo "[RUN] TransDecoder.Predict"
TransDecoder.Predict -t "$INPUT_FA"

echo "==============================="
echo "[DONE] TransDecoder completed"
echo "OUTDIR: $OUTDIR"
echo "==============================="

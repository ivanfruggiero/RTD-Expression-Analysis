#!/bin/bash
#PBS -N deseq_analysis
#PBS -l select=1:ncpus=16:mem=128gb
#PBS -l walltime=72:00:00
#PBS -q standard
#PBS -j oe
#PBS -o ../logs/deseq_analysis.log
#PBS -m abe
#PBS -M user@example.com

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qsub script/12_deseq_analysis.pbs [options]
  -m METADATA_DIR   directory with metadata CSV files (default: ../metadata)
  -q QUANTS_DIR     directory with Salmon quantifications (default: ../results/salmon/quants)
  -t TX2GENE        tx2gene TSV file (default: ../results/rtdmaker/tx2gene.tsv)
  -o OUTDIR         output directory (default: ../results/deseq)
  -r RSCRIPT        path to Rscript executable (default: Rscript)
  -h                show this help message

Example:
  qsub script/12_deseq_analysis.pbs -m ../metadata -q ../results/salmon/quants -t ../results/rtdmaker/tx2gene.tsv -o ../results/deseq
EOF
}

METADATA_DIR=${METADATA_DIR:-../metadata}
QUANTS_DIR=${QUANTS_DIR:-../results/salmon/quants}
TX2GENE=${TX2GENE:-../results/rtdmaker/tx2gene.tsv}
OUTDIR=${OUTDIR:-../results/deseq}
RSCRIPT=${RSCRIPT:-Rscript}

while getopts ":m:q:t:o:r:h" opt; do
  case $opt in
    m) METADATA_DIR=$OPTARG ;;
    q) QUANTS_DIR=$OPTARG ;;
    t) TX2GENE=$OPTARG ;;
    o) OUTDIR=$OPTARG ;;
    r) RSCRIPT=$OPTARG ;;
    h) usage; exit 0 ;;
    \?) echo "Invalid option: -$OPTARG" >&2; usage; exit 1 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 1 ;;
  esac
done

WORKDIR=${PBS_O_WORKDIR:-$(pwd)}
cd "$WORKDIR"

command -v "$RSCRIPT" >/dev/null 2>&1 || { echo "[ERROR] Rscript not found: $RSCRIPT" >&2; exit 1; }

if [ ! -d "$METADATA_DIR" ]; then
  echo "[ERROR] metadata directory not found: $METADATA_DIR" >&2
  exit 1
fi

if [ ! -d "$QUANTS_DIR" ]; then
  echo "[ERROR] quants directory not found: $QUANTS_DIR" >&2
  exit 1
fi

if [ ! -f "$TX2GENE" ]; then
  echo "[ERROR] tx2gene file not found: $TX2GENE" >&2
  exit 1
fi

mkdir -p "$OUTDIR"

cat <<EOF
===============================
[START] DESeq2 analysis
WORKDIR: $WORKDIR
METADATA_DIR: $METADATA_DIR
QUANTS_DIR: $QUANTS_DIR
TX2GENE: $TX2GENE
OUTDIR: $OUTDIR
RSCRIPT: $RSCRIPT
===============================
EOF

echo "[INFO] R version:"
"$RSCRIPT" -e 'cat("R = ", R.version.string, "\n")'

# Find all metadata CSV files
find "$METADATA_DIR" -name "*.csv" -type f | sort | while read -r META; do
  TAG=$(basename "$META" .csv)
  OUTROOT="$OUTDIR/$TAG"

  echo "==============================="
  echo "[RUN] $TAG"
  echo "[META] $META"
  echo "[OUT ] $OUTROOT"
  echo "==============================="

  if [ ! -s "$META" ]; then
    echo "[WARN] empty metadata: $META"
    continue
  fi

  mkdir -p "$OUTROOT"/{results,figures}

  # Create R script for this dataset
  cat > "$OUTROOT/run_de_${TAG}.R" <<'RS'
args <- commandArgs(trailingOnly=TRUE)
TAG     <- args[1]
META    <- args[2]
TX2GENE <- args[3]
QUANTS  <- args[4]
OUTROOT <- args[5]

FIGDIR <- file.path(OUTROOT,"figures")
RESDIR <- file.path(OUTROOT,"results")
dir.create(FIGDIR, showWarnings=FALSE, recursive=TRUE)
dir.create(RESDIR, showWarnings=FALSE, recursive=TRUE)

suppressPackageStartupMessages({
  library(tximport); library(readr); library(dplyr); library(tidyr)
  library(DESeq2); library(ggplot2)
})

apeglm_ok <- suppressWarnings(requireNamespace("apeglm", quietly=TRUE))
shrink_safe <- function(dds, coefname, res_default){
  if (length(coefname)==1 && apeglm_ok) {
    tryCatch(apeglm::lfcShrink(dds, coef=coefname, type="apeglm"),
             error=function(e){ message("[WARN] apeglm error: using unshrunk LFC"); res_default })
  } else {
    if (!apeglm_ok) message("[WARN] apeglm not available: using unshrunk LFC")
    res_default
  }
}

plotMA_gg <- function(res_df, title="MA plot", out_png=NULL) {
  df <- res_df
  if (!"baseMean" %in% colnames(df)) df$baseMean <- NA_real_
  df$log2FoldChange <- as.numeric(df$log2FoldChange)
  df$padj <- as.numeric(df$padj)
  df$baseMean <- as.numeric(df$baseMean)
  df$log10base <- log10(df$baseMean + 1)
  df$signif <- ifelse(!is.na(df$padj) & df$padj < 0.05, "sig", "ns")
  p <- ggplot(df, aes(x=log10base, y=log2FoldChange, alpha=signif)) +
    geom_point() +
    geom_hline(yintercept=c(-1,1), linetype="dashed") +
    theme_bw() +
    scale_alpha_manual(values=c(sig=1, ns=0.2)) +
    labs(title=title, x="log10(baseMean+1)", y="log2 fold change")
  if (!is.null(out_png)) ggsave(out_png, p, width=8, height=6)
  p
}

# Read metadata
meta <- read.csv(META, stringsAsFactors=FALSE)
meta <- meta %>% dplyr::filter(!is.na(sample) & sample != "")
meta$sample <- as.character(meta$sample)

# Determine design formula based on available columns
design_cols <- c()
if ("condition" %in% colnames(meta)) {
  meta$condition <- relevel(factor(meta$condition), ref="C")
  design_cols <- c(design_cols, "condition")
}
if ("time" %in% colnames(meta)) {
  meta$time <- factor(meta$time)
  design_cols <- c(design_cols, "time")
}
if ("genotype" %in% colnames(meta)) {
  meta$genotype <- factor(meta$genotype)
  design_cols <- c(design_cols, "genotype")
}
if ("batch" %in% colnames(meta) && length(unique(meta$batch)) >= 2) {
  meta$batch <- factor(meta$batch)
  design_cols <- c(design_cols, "batch")
}

if (length(design_cols) == 0) {
  stop("No design columns found in metadata")
}

design_formula <- as.formula(paste("~", paste(design_cols, collapse=" + ")))

# tximport
quant_files <- file.path(QUANTS, meta$sample, "quant.sf")
stopifnot(all(file.exists(quant_files)))
names(quant_files) <- meta$sample

tx2gene <- read.delim(TX2GENE, header=FALSE, stringsAsFactors=FALSE)
colnames(tx2gene) <- c("transcript","gene")

txi <- tximport(quant_files, type="salmon", tx2gene=tx2gene,
                countsFromAbundance="lengthScaledTPM",
                ignoreTxVersion=FALSE, ignoreAfterBar=TRUE)

dds <- DESeqDataSetFromTximport(txi, colData=meta, design=design_formula)
dds <- DESeq(dds)

# Results for each model coefficient
coef_names <- resultsNames(dds)
coef_names <- coef_names[coef_names != "Intercept"]  # escludi intercept

for (coef in coef_names) {
  res <- results(dds, name=coef)
  df <- as.data.frame(res); df$gene_id <- rownames(df)
  fname <- paste0("DE_", sub("condition_|time_|genotype_|batch_", "", coef), ".csv")
  write.csv(df, file=file.path(RESDIR, fname), row.names=FALSE)

  # MA plot
  plotMA_gg(df, title=paste(TAG, coef), out_png=file.path(FIGDIR, paste0("MA_", sub("condition_|time_|genotype_|batch_", "", coef), ".png")))
}

# Main results (if condition present) - kept for compatibility
if ("condition" %in% colnames(meta)) {
  res_main <- results(dds, contrast=c("condition","T","C"))
  df <- as.data.frame(res_main); df$gene_id <- rownames(df)
  write.csv(df, file=file.path(RESDIR,"DE_main_T_vs_C.csv"), row.names=FALSE)

  # MA plot
  plotMA_gg(df, title=paste(TAG, "T vs C"), out_png=file.path(FIGDIR,"MA_T_vs_C.png"))
}

# Save DDS
saveRDS(dds, file=file.path(RESDIR,"dds.rds"))

message("[OK] ", TAG)
RS

  # Execute R script
  "$RSCRIPT" "$OUTROOT/run_de_${TAG}.R" "$TAG" "$META" "$TX2GENE" "$QUANTS" "$OUTROOT" \
    2>&1 | tee "$OUTROOT/${TAG}.log"

done

echo "==============================="
echo "[DONE] DESeq2 analysis completed"
echo "OUTDIR: $OUTDIR"
echo "==============================="
